{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "1.0",
  "icons": { "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "host_permissions": ["<all_urls>"]
}
